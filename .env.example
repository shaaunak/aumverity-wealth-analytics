# =============================================================================
# AUMVERITY — Environment Configuration
# Copy to .env and adjust values for local development.
# =============================================================================

# Application
APP_NAME=AUMVERITY
APP_ENV=development
APP_VERSION=0.1.0
CALCULATION_VERSION=v1.0.0
REPORTING_CURRENCY=USD
LOG_LEVEL=INFO

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aumverity
POSTGRES_USER=aumverity
POSTGRES_PASSWORD=aumverity_dev_password
DATABASE_URL=postgresql+psycopg://aumverity:aumverity_dev_password@localhost:5432/aumverity

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=AUMVERITY
